+void powerDistributionSetMaxMotorThrust(uint16_t maxThrust)
+{
+  maxMotorThrust = maxThrust;
+}
+
+void powerDistributionSetSingleMotorThrustScale(uint8_t motorIndex,
+                                                uint8_t retainedPercent)
+{
+  if (motorIndex < STABILIZER_NR_OF_MOTORS) {
+    singleScaledMotorIndex = motorIndex;
+    singleMotorRetainedPercent = retainedPercent <= 100
+                                      ? retainedPercent
+                                      : 100;
+  } else {
+    singleScaledMotorIndex = UINT8_MAX;
+    singleMotorRetainedPercent = 100;
+  }
+}
+
+void powerDistributionResetCapStats(void)
+{
+  latestMaxRequested = 0;
+  latestMaxApplied = 0;
+  peakMaxRequested = 0;
+  capSampleCount = 0;
+  capHitCount = 0;
+}
+
+void powerDistributionGetCapStats(powerDistributionCapStats_t* stats)
+{
+  if (stats == NULL) {
+    return;
+  }
+
+  stats->maxAllowed =
+      singleScaledMotorIndex < STABILIZER_NR_OF_MOTORS
+          ? (uint16_t)(((uint32_t)UINT16_MAX *
+                        singleMotorRetainedPercent) / 100u)
+          : maxMotorThrust;
+  stats->latestRequested = latestMaxRequested;
+  stats->latestApplied = latestMaxApplied;
+  stats->peakRequested = peakMaxRequested;
+  stats->sampleCount = capSampleCount;
+  stats->capHitCount = capHitCount;
+}
